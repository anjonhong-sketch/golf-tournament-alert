rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function approvedOrganizer() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organizer'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approval == 'approved';
    }
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false; // Bootstrap administrators via Firebase Console / Admin SDK only.
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','name','role','approval','createdAt'])
        && request.resource.data.role in ['customer','organizer']
        && request.resource.data.approval == (request.resource.data.role == 'organizer' ? 'pending' : 'not_required')
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approval'])
        && request.resource.data.approval in ['pending','approved','rejected'];
      allow delete: if false;
    }
    match /organizerEvents/{eventId} {
      allow read: if resource.data.published == true || isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if approvedOrganizer()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerUid','title','published'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.published is bool;
      allow update: if (approvedOrganizer() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid) || isAdmin();
      allow delete: if isAdmin() || (approvedOrganizer() && resource.data.ownerUid == request.auth.uid);
    }
    match /tournaments/{eventId}/{kind}/{postId} {
      function knownRoom() {
        return eventId.matches('[a-zA-Z0-9-]{1,80}') && kind in ['chat', 'reviews'];
      }
      function validPost() {
        let post = request.resource.data;
        return post.keys().hasAll(['author', 'body', 'createdAt'])
          && post.keys().hasOnly(['author', 'body', 'createdAt'])
          && post.author == request.auth.uid
          && post.body is string && post.body.size() > 0
          && post.body.size() <= (kind == 'chat' ? 300 : 1500)
          && post.createdAt == request.time;
      }
      allow get: if request.auth != null && knownRoom();
      allow list: if request.auth != null && knownRoom() && request.query.limit <= 100;
      allow create: if request.auth != null && knownRoom() && validPost();
      allow update: if false;
      allow delete: if request.auth != null && knownRoom() && resource.data.author == request.auth.uid;
    }
  }
}
